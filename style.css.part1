:root {
  /* 纸感配色：桌面、纸张、墨色、赭红装订线、墨绿主色 */
  --desk: #e9e0d1;
  --paper: #fffdf6;
  --paper-deep: #fffefb;
  --line: #e2d6c2;
  --line-soft: #efe4d0;
  --ink: #332e26;
  --ink-soft: #6b6153;
  --ink-mute: #9a8d77;
  --accent: #2f5d4f;
  --accent-deep: #24493e;
  --margin: #c07a63;
  --gold: #c58a45;
  --danger: #a4462f;

  --tag-type-bg: #e8efe6;
  --tag-type-ink: #38614e;
  --tag-mood-bg: #f7e7d9;
  --tag-mood-ink: #9a5530;
  --tag-use-bg: #e7eaf1;
  --tag-use-ink: #45506e;
  --tag-other-bg: #efe9dc;
  --tag-other-ink: #7d6f57;
}

* {
  box-sizing: border-box;
}

body {
  margin: 0;
  padding: 20px 14px 96px;
  background-color: var(--desk);
  background-image: radial-gradient(rgba(120, 96, 64, 0.05) 1px, transparent 1px);
  background-size: 3px 3px;
  color: var(--ink);
  font-family: -apple-system, "Segoe UI", "Microsoft YaHei", "PingFang SC", sans-serif;
  font-size: 16px;
  line-height: 1.65;
}
